// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") 
}

enum MediaType {
  BOOK
  MOVIE
  SERIES
  COURSE
  PODCAST
  CUSTOM
}

enum StatusType {
  TO_CONSUME
  IN_PROGRESS
  COMPLETED
  DROPPED
}

enum UserRole {
  USER
  ADMIN
}

enum ReportStatus {
  PENDING
  REVIEWED
  REJECTED
}

enum NotificationType {
  FOLLOW
  COMMENT
}

model User {
  id String  @id
  email String @unique
  username String @unique
  name String?
  avatarUrl String?
  bio String?
  role      UserRole @default(USER)

  bannedUntil DateTime?
  logEntries LogEntry[]
  comments Comment[]
  
  followers Follows[] @relation("Followers") // На кого підписаний 
  following Follows[] @relation("Following") // Хто підписаний 

  reportsSent Report[] @relation("Reporter")
  reportsReceived Report[] @relation("ReportedUser")

  notifications Notification[]
  reactions Reaction[]
}

model LogEntry {
  id              Int            @id @default(autoincrement())
  userId          String         
  title           String
  mediaType       MediaType      // Enum: BOOK, MOVIE, COURSE, etc.
  status          StatusType     // Enum: TO_READ, IN_PROGRESS, COMPLETED
  rating          Int?           @map("user_rating") // Оцінка
  notes           String?        @db.Text
  isPublic        Boolean        @default(false)

  coverUrl    String?

  user User @relation(fields: [userId], references: [id])
  comments Comment[]
  
  createdAt DateTime @default(now())
  updatedAt  DateTime  @updatedAt

  reactions Reaction[]
}

model Comment {
  id Int @id @default(autoincrement())
  userId String        
  logEntryId Int  
  content String  @db.Text

  user User @relation(fields: [userId], references: [id])
  logEntry LogEntry @relation(fields: [logEntryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]
  reactions Reaction[]
}

model Follows {
  followerId String
  followingId String

  follower User @relation("Following", fields: [followerId], references: [id])
  following User  @relation("Followers", fields: [followingId], references: [id])

  createdAt DateTime  @default(now())

  @@id([followerId, followingId])
  @@map("follows") 
}

model Report {
  id Int @id @default(autoincrement())

  reporterId String
  reportedUserId String
  commentId Int?

  reason String
  status ReportStatus @default(PENDING)

  createdAt DateTime @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id])
  reportedUser User @relation("ReportedUser", fields: [reportedUserId], references: [id])
  comment Comment? @relation(fields: [commentId], references: [id])
}

model Notification {
  id String @id @default(cuid())

  userId String   
  actorId String?

  type NotificationType
  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Reaction {
  id         Int      @id @default(autoincrement())
  userId     String
  logEntryId Int?
  commentId  Int?
  emoji      String
  
  user       User     @relation(fields: [userId], references: [id])
  logEntry   LogEntry? @relation(fields: [logEntryId], references: [id])
  comment    Comment?  @relation(fields: [commentId], references: [id])
  
  createdAt  DateTime @default(now())
  
  @@unique([userId, logEntryId, emoji])
  @@unique([userId, commentId, emoji])
}
